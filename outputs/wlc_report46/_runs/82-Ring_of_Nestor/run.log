      "confidence": "medium"
    },
    {
      "local_ref": "e5",
      "text": "文章摘要开头：“The so-called Nestor Ring was found in 1924 and 
was accepted as authentic by Sir Arthur Evans whereas many other scholars 
condemned it as a forgery.”",
      "document_ref": "d3",
      "source_ref": "s3",
      "evidence_type": "quote",
      "locator": null,
      "qualifiers": [],
      "limitations": [
