# 密钥与服务连接信息；模型、超时、重试和并发在 evaluate.yaml 中配置。
# Agent 使用的 OpenAI 兼容接口。
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Langfuse Observability Configuration (optional)
# Set both keys to trace LangChain/LangGraph runs. LANGFUSE_BASE_URL supports
# Langfuse self-hosting; omit it when using Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Web Search Configuration
TAVILY_API_KEY=your-tavily-api-key-here

# DeepResearch Bench evaluator
DRB_OPENAI_API_KEY=
DRB_OPENAI_BASE_URL=https://api.openai.com/v1
DRB_OPENROUTER_API_KEY=
DRB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DRB_JINA_API_KEY=

# Wiki Live Challenge evaluator
WLC_JINA_API_KEY=
WLC_JINA_BASE_URL=https://r.jina.ai/
WLC_EXTRACT_API_KEY=
WLC_EXTRACT_BASE_URL=
WLC_VERIFIER_API_KEY=
WLC_VERIFIER_BASE_URL=
WLC_WRITING_API_KEY=
WLC_WRITING_BASE_URL=
WLC_EMBEDDING_API_KEY=
WLC_EMBEDDING_BASE_URL=https://api.openai.com/v1

# DeepResearch Bench II evaluator
DRB2_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
DRB2_OPENAI_API_KEY=

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=zxc123456
NEO4J_DATABASE=neo4j
