[tools:8699c9e1-2679-bf75-b8d1-2e01dea5b088] [get_report_evidence result] {"query": {"id": 
"20260627083401849642_81da8a9c", "handle": "q2", "text": "\"The Rector of Justin\" novel plot summary characters 
themes", "importance": "core"}, "items": [{"id": "20260627083631892180_66a74900", "type": "Evidence", "text": 
"“The Rector of Justin is a 1964 psychological novel by American author Louis Auchincloss, chronicling the life 
and character of Reverend Frank Prescott, the founder and long-serving rector of Justin Martyr, a fictional elite 
Episcopal boys' preparatory school in rural New England.”", "source_ids": ["20260627083630904704_5aa46fc6"], 
"citations": [11]}, {"id": "20260627083631913754_db3606f3", "type": "Evidence", "text": "“Author: Louis 
Auchincloss\nFirst published: 1964\nGenre: Novel\nLocale: Primarily New York City and New England\nPlot: 
Social\nTime: 1887–1947”", "source_ids": ["20260627083630915755_3f11f956"], "citations": [12]}, {"id": 
"20260627083631937792_9f4fdcce", "type": "Evidence", "text": "“The narrative unfolds through the retrospective 
accounts of six narrators—including former students, colleagues, and family members—who offer contrasting 
perspectives on Prescott's authoritarian leadership, personal hypocrisies, and unyielding commitment to classical 
education and Christian moral rigor, revealing a man both inspiring and flawed.”", "source_ids": 
["20260627083630904704_5aa46fc6"], "citations": [11]}, {"id": "20260627083631962060_06f6b2f5", "type": "Evidence",
"text": "“Francis (Frank) Prescott, the rector, or headmaster, of Justin Martyr Academy. He is the central figure 
of the novel. Although orphaned, he is able to attend good schools because of family trusts; by the time he is 
seventeen years old, he has determined to create his own Christian preparatory school.”", "source_ids": 
["20260627083630915755_3f11f956"], "citations": [12]}, {"id": "20260627083631988368_d4365be3", "type": "Evidence",
"text": "“Educated at Harvard University and the University of Oxford… Frank temporarily loses the faith essential
to his ambition and goes to work for the New York Central Railroad. His faith returns, and he goes to divinity 
school, is ordained, and founds his school thirty miles west of Boston. It flourishes.”", "source_ids": 
["20260627083630915755_3f11f956"], "citations": [12]}, {"id": "20260627083632015563_34f8af3e", "type": "Evidence",
"text": "“Boys are required to attend daily chapel, to wear blue suits on Sunday, and to enter the dining room in 
marching order. Discipline is strict, and planned activities, chiefly schoolwork, rugged sport, and worship, keep 
the boys occupied and usually out of mischief.”", "source_ids": ["20260627083630915755_3f11f956"], "citations": 
[12]}, {"id": "20260627083632047906_bb2bdce7", "type": "Evidence", "text": "“His methods, progressive when 
introduced, appear old-fashioned by the time he retires in 1941. ... The rector, an inspiring teacher to thousands
of boys, becomes a legend. In retirement, though, he has moments of doubt about his life's work.”", "source_ids": 
["20260627083630915755_3f11f956"], "citations": [12]}, {"id": "20260627083632073813_b26231e4", "type": "Evidence",
"text": "“Brian Aspinwall, who comes to Justin in 1939, replacing a teacher who has departed for military service.
Slight, timid, sensitive Brian has been rejected because of a heart murmur. He wants to be a minister but lacks 
self-confidence. Frank admires Brian's ability to please his dying wife. He consents to Brian's writing his 
biography. Much of the story is in the form of Brian's entries into his diaries; the rest is from memoirs gathered
from others.”", "source_ids": ["20260627083630915755_3f11f956"], "citations": [12]}, {"id": 
"20260627083632098332_2d2632a9", "type": "Evidence", "text": "Grokipedia 指出：“the main framework is provided by 
the diary of young English master and would-be biographer Brian Aspinwall, who arrives at Justin Martyr in 1939 
and, with Prescott's consent, sets out to write his life, interweaving accounts by Horace Havistock, David 
Griscam, Jules Griscam, Cordelia Prescott, Charley Strong, and others.”", "source_ids": 
["20260627083630904704_5aa46fc6"], "citations": [11]}, {"id": "20260627083632121150_ff870d3c", "type": "Evidence",
"text": "GradeSaver 摘要：“The story follows the life and career of Frank Prescott—the influential headmaster of 
the prestigious Justin Martyr School. It begins with Brian Aspinwall, a former student of Justin Martyr, 
reflecting on his experiences and the impact Frank Prescott had on his life. Aspinwall serves as the narrator 
providing insights into Prescott's character and the events that shaped him.”", "source_ids": 
["20260627083630927913_94cf3e5b"], "citations": [13]}, {"id": "20260627083632143870_112e3648", "type": "Evidence",
"text": "Mysterium Coniunctionis 检索摘要：“The Rector of Justin. Brian Aspinwall becomes at age 27 a teacher at a
prestigious private boys' school in New England. He is recruited suddenly ...”", "source_ids": 
["20260627083630996656_5b9416e6"], "citations": [19]}, {"id": "20260627083632169895_99c8081b", "type": "Evidence",
"text": "“Harriet Winslow Prescott, a member of an old Boston family. She meets Frank during his days at divinity 
school. She marries him following his ordination and works with him to found and run Justin Martyr. She dies 
shortly before Frank's retirement. Tall, large-nosed, and plain, she is also intelligent, cultivated, and 
independent in mind and spirit.”", "source_ids": ["20260627083630915755_3f11f956"], "citations": [12]}, {"id": 
"20260627083632194211_3829860f", "type": "Evidence", "text": "GradeSaver 摘要：“His wife Harriet struggles with 
her role as a headmaster's wife often feeling overshadowed by her husband's devotion to the school. The tensions 
between their personal lives with three daughters and his dedication to Justin Martyr create conflicts.”", 
"source_ids": ["20260627083630927913_94cf3e5b"], "citations": [13]}, {"id": "20260627083632217152_af0f9e46", 
"type": "Evidence", "text": "“Cordelia Prescott Turnbull, the youngest of Frank and Harriet's three daughters, the
rebel in the family. She tells Brian her story. After eloping at t...”", "source_ids": 
["20260627083630915755_3f11f956"], "citations": [12]}, {"id": "20260627083632238833_46f103bf", "type": "Evidence",
"text": "GradeSaver Essay Questions 回答：“Cordelia and her father have a strained relationship. Cordelia is a 
bold girl who demands explanations from her father whenever she thinks things are not going well. ... Cordelia 
believes her father is gay because he loves men more than women.”", "source_ids": 
["20260627083630940451_8bfb1811"], "citations": [14]}, {"id": "20260627083632262748_37c67994", "type": "Evidence",
"text": "“Horace Havistock, Frank's lifelong friend, an early religious enthusiast who founded a boys' boarding 
school and whose educational ideals have a significant impact on Prescott.”", "source_ids": 
["20260627083630904704_5aa46fc6"], "citations": [11]}, {"id": "20260627083632284441_92ae2c2f", "type": "Evidence",
"text": "EBSCO 对 David Griscam 的概述：“David Griscam, once a problem student at Justin, later becomes a 
successful lawyer and major benefactor of the school.”", "source_ids": ["20260627083630915755_3f11f956"], 
"citations": [12]}, {"id": "20260627083632308018_a0fb1851", "type": "Evidence", "text": "Grokipedia：“Duncan 
Moore, Frank's successor as rector in 1941, implements liberalizing reforms and modernization, provoking tensions 
between tradition and progress at Justin Martyr.”", "source_ids": ["20260627083630904704_5aa46fc6"], "citations": 
[11]}, {"id": "20260627083632334039_8b3d99f1", "type": "Evidence", "text": "eNotes snippet: “Duncan Moore becomes 
Frank Prescott's successor as the rector of Justin in 1941, ushering in an era of liberal reform and 
modernization. His initiatives, ... Although Frank initially contemplates opposing Duncan's reforms, he is 
ultimately dissuaded by Brian Aspinwall and David Griscam, illustrating the complex...”", "source_ids": 
["20260627083630952368_8b3e7167"], "citations": [15]}, {"id": "20260627083632359985_365fe645", "type": "Evidence",
"text": "GradeSaver Essay Questions 另一回答：“Prescott is already 82 years old when the board forces him to 
retire. He has become less efficient, and his mental and physical abilities are weakening. ... The board wants a 
young, energetic man to take over as headmaster, and David is chosen as his successor.”", "source_ids": 
["20260627083630940451_8bfb1811"], "citations": [14]}, {"id": "20260627083632383987_dda3b228", "type": "Evidence",
"text": "Grokipedia 关于主题：“Auchincloss, drawing from his own experiences at Groton School and his background 
in Manhattan's upper echelons, uses the novel to probe themes of power, faith, and institutional tradition amid 
mid-20th-century social shifts, portraying Prescott as a domineering figure whose ideals clash with evolving 
societal norms and personal scandals.”", "source_ids": ["20260627083630904704_5aa46fc6"], "citations": [11]}, 
{"id": "20260627083632407933_07822041", "type": "Evidence", "text": "EBSCO 主题总结：“The narrative is enriched 
with the struggles and aspirations of these characters, revealing themes of faith, redemption, and the impact of 
educational institutions on personal growth. As the story unfolds, it illustrates the evolving dynamics within the
school and the challenges posed by changing societal norms, particularly through the lens of Duncan Moore, who 
succeeds Frank as rector, sparking debates about tradition and progress.”", "source_ids": 
["20260627083630915755_3f11f956"], "citations": [12]}, {"id": "20260627083632433209_98442be7", "type": "Evidence",
"text": "GradeSaver：“As the years pass, the narrative jumps forward highlighting key moments in Prescott's tenure
at Justin Martyr. We witness the changing social landscape and the impact of world events such as the Great 
Depression and World War II on the school and its community.”", "source_ids": ["20260627083630927913_94cf3e5b"], 
"citations": [13]}, {"id": "20260627083632457444_3f18dd46", "type": "Evidence", "text": "Literariness.org snippet:
“... characters a thoughtful examination of a powerful American institution. The main narrator of The Rector of 
Justin is Brian Aspinwall, whose ...”", "source_ids": ["20260627083630964304_f8cd8b27"], "citations": [16]}, 
{"id": "20260627083632484859_1f9669bd", "type": "Evidence", "text": "Washington Post snippet: “\"The Rector of 
Justin\" is a \"prep school novel\" in the same way that \"Moby-Dick\" is a \"whaling novel.\" It uses the 
environment of a ...”", "source_ids": ["20260627083630975908_5d9166b7"], "citations": [17]}, {"id": 
"20260627083632513659_ea22769f", "type": "Evidence", "text": "Grokipedia 引 Jonathan Yardley：“in a 2008 
Washington Post review, Jonathan Yardley described Prescott as ‘one of the great characters in American 
fiction.’”", "source_ids": ["20260627083630904704_5aa46fc6"], "citations": [11]}, {"id": 
"20260627083632542773_ea722d9b", "type": "Evidence", "text": "Robert M. Adams 在《纽约书评》：“The Rector of 
Justin, his latest production, represents an old fashioned ‘character study’ of the headmaster of an Episcopal 
boy's school. Dr. Francis ...”", "source_ids": ["20260627083630986744_96aa17d3"], "citations": [18]}, {"id": 
"20260627083632570567_591dbd78", "type": "Evidence", "text": "NYT snippet: “And, for his own special audience, 
Auchincloss provides a brief account of the composition of his ‘The Rector of Justin’ (1964), telling how ...”", 
"source_ids": ["20260627083631007029_c3e5c3bb"], "citations": [20]}, {"id": "20260627083758769573_6deddf3d", 
"type": "Claim", "text": "The Rector of Justin is a 1964 psychological novel by American author Louis Auchincloss 
that chronicles the life and character of Reverend Francis (Frank) Prescott, founder and long‑serving rector of 
Justin Martyr, a fictional elite Episcopal boys’ preparatory school in rural New England.", "source_ids": 
["20260627083630904704_5aa46fc6", "20260627083630915755_3f11f956"], "citations": [11, 12]}, {"id": 
"20260627083758832346_feeef6b7", "type": "Claim", "text": "The narrative of The Rector of Justin spans roughly 
1887–1947, primarily in New York City and New England, and follows Frank Prescott’s rise from orphaned student 
with a vocation to found a Christian preparatory school, through his education at Harvard and Oxford, a crisis and
restoration of faith, ordination, and the flourishing of Justin Martyr Academy about thirty miles west of 
Boston.", "source_ids": ["20260627083630915755_3f11f956"], "citations": [12]}, {"id": 
"20260627083758904085_7c01a7fb", "type": "Claim", "text": "Justin Martyr Academy under Frank Prescott is depicted 
as a strictly run Episcopal boys’ boarding school where daily chapel attendance, Sunday blue suits, marching into 
the dining room, and a full schedule of schoolwork, sports, and worship enforce religious discipline and keep 
students occupied.", "source_ids": ["20260627083630915755_3f11f956"], "citations": [12]}, {"id": 
"20260627083758939834_8feda8d2", "type": "Claim", "text": "The Rector of Justin uses a multi‑voiced, retrospective
narrative structure in which the main framework is provided by the diary of young English master and would‑be 
biographer Brian Aspinwall, who arrives at Justin Martyr in 1939 to teach, and interweaves memoirs, letters, and 
recollections from former students, colleagues, and family members such as Horace Havistock, David and Jules 
Griscam, Cordelia Prescott, and Charley Strong to build a composite portrait of Frank Prescott.", "source_ids": 
["20260627083630904704_5aa46fc6", "20260627083630915755_3f11f956", "20260627083630927913_94cf3e5b", 
"20260627083630964304_f8cd8b27"], "citations": [11, 12, 13, 16]}, {"id": "20260627083759038626_da55ded0", "type": 
"Claim", "text": "Brian Aspinwall is portrayed as a slightly built, timid, sensitive young English teacher at 
Justin Martyr, aged about twenty‑seven when he is suddenly recruited in 1939 to replace a master who left for 
military service; rejected for military duty himself because of a heart murmur, he aspires to be a minister but 
lacks self‑confidence, and with Prescott’s consent undertakes to write Prescott’s biography through his diary.", 
"source_ids": ["20260627083630904704_5aa46fc6", "20260627083630915755_3f11f956", "20260627083630996656_5b9416e6"],
"citations": [11, 12, 19]}, {"id": "20260627083759110397_fd66af72", "type": "Claim", "text": "Frank Prescott is 
depicted as an orphan who, thanks to family trusts, attends elite schools, forms an early ambition by age 
seventeen to found his own Christian preparatory school, and later becomes the central, almost legendary rector of
Justin Martyr, inspiring thousands of boys yet exhibiting authoritarian leadership and personal flaws.", 
"source_ids": ["20260627083630904704_5aa46fc6", "20260627083630915755_3f11f956", "20260627083630986744_96aa17d3"],
"citations": [11, 12, 18]}, {"id": "20260627083759205012_d0b00232", "type": "Claim", "text": "Harriet Winslow 
Prescott, from an old Boston family, meets Frank during his divinity‑school years, marries him after his 
ordination, and works alongside him to found and run Justin Martyr; she is described as tall, plain, intelligent, 
cultivated, and independent, yet her role as the headmaster’s wife leaves her feeling overshadowed by Frank’s 
devotion to the school and contributes to tensions within their family life with their three daughters.", 
"source_ids": ["20260627083630915755_3f11f956", "20260627083630927913_94cf3e5b"], "citations": [12, 13]}, {"id": 
"20260627083759264705_b0809d2b", "type": "Claim", "text": "Cordelia Prescott Turnbull, the youngest and most 
rebellious of Frank and Harriet’s three daughters, narrates her story to Brian Aspinwall, and her perspective 
emphasizes dissatisfaction with her father’s ideals and the gendered expectations and roles imposed within the 
Prescott family and the school’s male‑centered mission.", "source_ids": ["20260627083630915755_3f11f956", 
"20260627083630940451_8bfb1811"], "citations": [12, 14]}, {"id": "20260627083759315796_bde935d0", "type": "Claim",
"text": "Horace Havistock, Frank Prescott’s lifelong friend and an early religious enthusiast who founded a boys’ 
boarding school of his own, significantly shapes Prescott’s educational ideals for Justin Martyr.", "source_ids": 
["20260627083630904704_5aa46fc6", "20260627083630915755_3f11f956"], "citations": [11, 12]}, {"id": 
"20260627083759355236_8e4355de", "type": "Claim", "text": "David Griscam is portrayed as a former problem student 
at Justin Martyr who later becomes a successful lawyer and major benefactor of the school, embodying the social 
elite produced by Prescott’s institution while also expressing reservations about Prescott’s conservative style 
and later helping dissuade Frank from openly opposing Duncan Moore’s reforms.", "source_ids": 
["20260627083630915755_3f11f956", "20260627083630940451_8bfb1811", "20260627083630952368_8b3e7167"], "citations": 
[12, 14, 15]}, {"id": "20260627083759421376_7cf228b0", "type": "Claim", "text": "Within the novel, Frank 
Prescott’s initially progressive methods of school governance and education gradually come to appear 
old‑fashioned, and by the time of his retirement in 1941 he has become a legendary but out‑of‑date rector who, in 
retirement, experiences moments of doubt about the value of his life’s work.", "source_ids": 
["20260627083630915755_3f11f956"], "citations": [12]}, {"id": "20260627083759465805_f988e603", "type": "Claim", 
"text": "Duncan Moore succeeds Frank Prescott as rector of Justin Martyr in 1941 and initiates an era of 
liberalizing reforms and modernization at the school, provoking tensions between tradition and progress and 
leading Frank initially to contemplate opposing these changes until he is dissuaded by Brian Aspinwall and David 
Griscam.", "source_ids": ["20260627083630904704_5aa46fc6", "20260627083630915755_3f11f956", 
"20260627083630940451_8bfb1811", "20260627083630952368_8b3e7167"], "citations": [11, 12, 14, 15]}], "offset": 0, 
"limit": 40, "total": 43, "next_offset": 40}
