[tools:0ba9c219-3193-6ab4-5e68-0131cbef41c6] [AIMessage → tool] commit_report_chapter({'chapter_id': 1, 'title': 
'Overview', 'content': 'The 2011 Sawyerville–Eoline tornado was a long-track, violent tornado that struck portions of 
Greene, Hale, and Bibb Counties in west-central Alabama on 27 April 2011, during the historic late-April 2011 tornado 
outbreak in the southeastern United States.[1][2][9] According to official National Weather Service (NWS) documentation,
the tornado was rated EF3 on the Enhanced Fujita scale, with a surveyed damage path length of 72.13 mi (116.1 km) and a 
maximum path width of 1,760 yd (1.0 mi).[1][2] The event caused severe damage to homes, businesses, community 
facilities, and forested areas along its route and resulted in seven fatalities and fifty injuries.[1][2] \n\nThe 
tornado is named for the communities of Sawyerville in Hale County and Eoline in Bibb County, which experienced some of 
the most intense damage, including destruction of residential structures and the local fire department in Eoline.[2] The
NWS Birmingham office lists the Sawyerville–Eoline tornado among the significant tornadoes of 27 April 2011, a day on 
which numerous strong and violent tornadoes affected Alabama.[1][9] The Alabama Tornado Database for 2011 includes a 
distinct entry for this tornado, documenting its EF3 rating, multi-county track through Greene, Hale, and Bibb Counties,
and associated casualties.[1]', 'source_ids': ['20260702015120843257_5622ba2b', '20260702015353537882_06a24196', 
'20260702020545979708_34355001'], 'evidence_ids': ['20260702015431432237_e23587c0', '20260702015431903951_585d8b80', 
'20260702020731950948_37b96771', '20260702020732041650_25f6a1f2', '20260702020732236417_6e054f4e', 
'20260702020034210900_ced7fc2d', '20260702020034296749_0be46fe8', '20260702020034389368_bc904477', 
'20260702020034473637_cef852eb', '20260702020607753942_dbec485a', '20260702020607915578_5563ea33', 
'20260702020608041510_97f19a16', '20260702015121314576_892477e1', '20260702015121395031_e310c7e7', 
'20260702015121483951_ff4cc3dd', '20260702020549432608_95f65294'], 'section_type': 'lead'})
