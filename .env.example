# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
GR_MODEL=gpt-5.6-luna
# 自定义模型别名必须显式指定 Reporter 分词器（gpt-5.6-luna 对应 o200k_base）。
GR_REPORTER_TOKENIZER=o200k_base
# 报告章节写作的最大并发数。
GR_REPORTER_CHAPTER_CONCURRENCY=3
# 全文润色模型单次请求的等待时间，单位为秒。
GR_REPORTER_POLISH_TIMEOUT=600
# 搜索调度阶段并发的最大搜索数。
GR_SEARCH_DISPATCH_CONCURRENCY=3
# 查询评估阶段并发的最大评估数。
GR_ASSESS_QUERY_CONCURRENCY=3

# 章节应用预算；输入上限等于总预算减去输出预留和安全余量。
GR_REPORTER_CONTEXT_TOKENS=32768
GR_REPORTER_OUTPUT_TOKENS=8192
GR_REPORTER_SAFETY_TOKENS=1024
GR_REPORTER_SOURCE_TOKENS=2000
# 默认按 GR_MODEL 识别；自定义模型别名必须显式指定 tiktoken 编码名称。
GR_REPORTER_TOKENIZER=

# Langfuse Observability Configuration (optional)
# Set both keys to trace LangChain/LangGraph runs. LANGFUSE_BASE_URL supports
# Langfuse self-hosting; omit it when using Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Web Search Configuration
TAVILY_API_KEY=your-tavily-api-key-here
SEARCH_TIMEOUT=30

# 硬屏蔽来源（逗号分隔；命中的来源在证据入图前整源剔除，报告永不引用）。
# URL 支持归一化精确匹配与包含匹配；标题为忽略大小写的子串匹配。
GR_BLOCKED_URLS=
GR_BLOCKED_TITLES=

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=zxc123456
NEO4J_DATABASE=neo4j
