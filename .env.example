# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration
GR_MODEL=gpt-5.1
GR_MODEL_TIMEOUT=180

# Reporter mode: global uses one full-context writer; chapters uses the legacy workflow.
GR_REPORTER_MODE=global
GR_REPORTER_FALLBACK=1
GR_REPORTER_GLOBAL_MODEL=
GR_REPORTER_GLOBAL_TIMEOUT=600
GR_GLOBAL_WRITER_OUTPUT_TOKENS=40000
GR_GLOBAL_PACKET_TOKENS=48000
# 报告章节写作的最大并发数。
GR_REPORTER_CHAPTER_CONCURRENCY=3
# 全文润色模型单次请求的等待时间，单位为秒。
GR_REPORTER_POLISH_TIMEOUT=600
# 搜索调度阶段并发的最大搜索数。
GR_SEARCH_DISPATCH_CONCURRENCY=3
# 查询评估阶段并发的最大评估数。
GR_ASSESS_QUERY_CONCURRENCY=3

# 章节应用预算；输入上限等于总预算减去输出预留和安全余量。
GR_REPORTER_CONTEXT_TOKENS=32768
GR_REPORTER_OUTPUT_TOKENS=8192
GR_REPORTER_SAFETY_TOKENS=1024
GR_REPORTER_SOURCE_TOKENS=2000
# 默认按 GR_MODEL 识别；自定义模型别名必须显式指定 tiktoken 编码名称。
GR_REPORTER_TOKENIZER=

# Langfuse Observability Configuration (optional)
# Set both keys to trace LangChain/LangGraph runs. LANGFUSE_BASE_URL supports
# Langfuse self-hosting; omit it when using Langfuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Web Search Configuration
TAVILY_API_KEY=your-tavily-api-key-here
SEARCH_TIMEOUT=30

# DeepResearch Bench evaluator
DRB_LLM_BACKEND=openai
DRB_OPENAI_API_KEY=
DRB_OPENAI_BASE_URL=https://api.openai.com/v1
DRB_OPENROUTER_API_KEY=
DRB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DRB_RACE_MODEL=gpt-5.5
DRB_FACT_MODEL=gpt-5.4-mini
DRB_LLM_HTTP_TIMEOUT=600
DRB_MAX_OUTPUT_TOKENS=64000
DRB_JINA_API_KEY=

# Wiki Live Challenge evaluator
WLC_JINA_API_KEY=
WLC_JINA_BASE_URL=https://r.jina.ai/
WLC_EXTRACT_MODEL=gemini-2.5-flash
WLC_EXTRACT_API_KEY=
WLC_EXTRACT_BASE_URL=
WLC_VERIFIER_MODEL=gemini-2.5-flash
WLC_VERIFIER_API_KEY=
WLC_VERIFIER_BASE_URL=
WLC_WRITING_MODEL=gemini-2.5-pro
WLC_WRITING_API_KEY=
WLC_WRITING_BASE_URL=
WLC_EMBEDDING_MODEL=text-embedding-3-small
WLC_EMBEDDING_API_KEY=
WLC_EMBEDDING_BASE_URL=https://api.openai.com/v1
WLC_API_TIMEOUT=300
WLC_MAX_RETRIES=3
WLC_CONCURRENCY=10

# DeepResearch Bench II evaluator
DRB2_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
DRB2_OPENAI_API_KEY=
DRB2_OPENAI_MODEL=gpt-5.5
DRB2_REASONING_EFFORT=medium
DRB2_MAX_OUTPUT_TOKENS=32768
DRB2_TIMEOUT=600

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=zxc123456
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT=30
