      "source_type": "paper"
    },
    {
      "local_ref": "s5",
      "url": "https://www.journals.uchicago.edu/doi/pdfplus/10.2307/507325",
      "title": "Deconstructing a Narrative of Epiphany on the Isopata Ring",
      "source_type": "paper"
    }
