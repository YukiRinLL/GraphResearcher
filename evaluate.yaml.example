# 运行参数在本文件配置，密钥和服务连接信息在根目录 .env 中配置。
version: 1  # 配置版本，目前只支持 1。
mode: run_and_evaluate  # run：只生成；evaluate：只评分；run_and_evaluate：生成后评分。
seed: 20260918  # 随机抽样种子，用于复现样本选择。
sample_count: 5  # 每个 Benchmark 的样本数；null 表示全部。

agent:
  name: graphresearcher  # Agent 名称，用于自动生成运行目录名。
  model: gpt-5.1  # 搜索抽取、证据评估等环节使用的模型。
  model_timeout_seconds: 180  # 单次模型请求的超时秒数。
  search_timeout_seconds: 30  # 单次搜索请求的超时秒数。
  max_rounds: 30  # 每条样本的搜索派发次数上限；0 表示不限。
  timeout_seconds: 7200  # 每条样本生成报告的总时限（秒）；-1 表示不限。
  max_retries: 3  # 每次模型调用的额外重试次数；0 表示不重试。
  max_workers: 1  # 同时运行的样本数；默认 1，表示串行。
  search_dispatch_concurrency: 3  # 每个 Agent 进程同时派发的 Query 数量上限；1 表示串行。省略时使用 .env 或默认值 3。
  source_extraction_concurrency: 3  # 每个 Agent 进程的来源模型调用总并发上限，所有 Query 共用；1 表示串行。省略时使用 .env 或默认值 3。
  assess_query_concurrency: 3  # 每个 Agent 进程同时执行的 Query 证据评估数。
  llm_circuit_failures: 2  # 同一 (purpose, prompt) 连续失败多少次后熔断；须大于 0。
  llm_circuit_cooldown_seconds: 600  # 熔断冷却窗口秒数；0 表示失败累计但不短路。
  merge_normalize_assess: 1  # 1：首次 Query 评估把 Claim 规范化并入 assessor 单次调用；0：恢复 normalizer/assessor 双调用。
  verbosity: quiet  # quiet：简略；normal：进度；debug：工具调用及详细日志。
  # 每个 LLM 环节可单独指定模型；留空或删除某个键时回退到上面的 agent.model。
  models:
    planner: deepseek-v4-pro # init：初始 Query 与研究目标规划
    source_analyzer: deepseek-v4-pro # Searcher 逐网页来源的证据抽取（调用量最大）
    query_reformulator: deepseek-v4-pro # 首轮搜索全部撞重时改写检索词
    claim_normalizer: deepseek-v4-pro # Claim 规范化归并
    query_assessor: deepseek-v4-pro # Query 证据充分性裁决
    portfolio: deepseek-v4-pro # 全局组合评估与 gap 取舍
    gap_expander: deepseek-v4-pro # follow-up 子 Query 撰写
    convergence: deepseek-v4-pro # 收敛裁决
  reporter:
    model: ""  # 留空时继承 agent.model。
    reviewer_model: ""  # 报告复核模型；留空时继承 agent.model。
    model_timeout_seconds: 600  # 全局报告写作模型的单次请求超时秒数。
    packet_tokens: 48000  # 报告证据包的 token 预算。
    output_tokens: 40000  # 报告写作模型的最大输出 token 数。

execution:
  resume: true  # 跳过同一运行目录中已完成且有报告的样本；评分仍会重跑。
  fail_fast: false  # 编排异常时退出；已记录的失败状态不一定触发退出。
  pipeline: false  # true：每条报告生成结束即进入评估；false：整批生成后再评估。仅影响 run_and_evaluate。
  evaluation_max_workers: 1  # 同时评分的样本数；默认 1，表示串行。

output:
  root: outputs/evaluations  # 结果根目录。
  run_id: null  # 运行目录名；null 自动生成，固定名称可用于续跑。
  markdown_summary: true  # 生成 Markdown 汇总；JSON 汇总始终生成。

input:  # evaluate 模式需指定 run_dir 或 native 报告路径。
  run_dir: null  # 已有运行目录；使用其中记录的样本，不重新抽样。
  native:
    deep_research_bench_jsonl: null  # 原生 JSONL 报告，包含 id、prompt、article。
    wiki_live_challenge_markdown_dir: null  # 原生报告目录，文件名为 <文章名称>.md。
    deep_research_bench_ii_report_dir: null  # 原生报告目录，文件名为 idx-<样本编号>.md。

benchmarks:  # 至少启用一个 Benchmark；仅测试 Bench I 时关闭另外两个。

  deep_research_bench:
    enabled: true  # 是否启用 DeepResearch Bench I。
    sample_count: null  # 覆盖顶层样本数；null 表示继承。
    runtime:
      backend: openai  # 可选 openai 或 openrouter，对应凭据从 .env 读取。
      race_model: gpt-5.5
      fact_model: gpt-5.4-mini
      model_timeout_seconds: 600
      max_output_tokens: 64000
    selection:
      languages: [zh, en]  # 语言筛选：zh、en；[] 表示不限。
      topics: []  # 按数据集 topic 精确筛选；[] 表示不限。
    evaluation:
      dimensions: [race, fact]  # race：报告质量；fact：引用事实验证；可选子集。
      max_workers: 5  # RACE 评测器内部线程数。
      fact:
        processes: 5  # FACT 各阶段的进程数。

  wiki_live_challenge:
    enabled: true  # 是否启用 Wiki Live Challenge。
    sample_count: null  # 覆盖顶层样本数；null 表示继承。
    runtime:
      extract_model: gemini-2.5-flash
      verifier_model: gemini-2.5-flash
      writing_model: gemini-2.5-pro
      embedding_model: text-embedding-3-small
      model_timeout_seconds: 300
      max_retries: 3  # 原生评测客户端的重试参数。
      concurrency: 10  # 原生预处理等环节使用的并发数，与 evaluation.max_workers 分别生效。
    selection:
      dataset: 2025_Mar_Nov  # 数据集子目录名。
      categories: []  # 样本类别筛选；当前数据集保持 []。
    preprocessing:
      normalize_markdown: true  # 评分前规范化 Markdown 副本。
      steps: [extract, fetch]  # extract：抽取陈述；fetch：抓取引用网页。
    evaluation:
      dimensions: [writing, verifiability, citation]  # 写作、陈述核验、引用支持三项评分，可选子集。
      max_workers: 5  # 陈述核验内部并发数；citation 当前有参数兼容问题。
      writing:
        allow_tie: true  # 写作比较是否允许打平。
        categories: []  # 写作评分类别：well_written、broad_coverage、neutral；[] 表示全部。
      verifiability:
        top_k: 10  # 每条陈述选取的相似候选陈述数。

  deep_research_bench_ii:
    enabled: true  # 是否启用 DeepResearch Bench II。
    sample_count: null  # 覆盖顶层样本数；null 表示继承。
    runtime:
      model: gpt-5.5
      reasoning_effort: medium
      max_output_tokens: 32768
      model_timeout_seconds: 600
    selection:
      languages: [zh, en]  # 语言筛选：zh、en；[] 表示不限。
      themes: []  # 按数据集 theme 精确筛选；[] 表示不限。
    evaluation:
      chunk_size: 50  # 每批评分条目数；0 表示不分批。
      max_workers: 5  # 原生评测器的报告处理线程数。
      max_retries: 10  # 每批评分的总尝试次数，包含首次；须大于 0。
      max_paper_chars: 150000  # 送入评分模型的报告字符数上限。
